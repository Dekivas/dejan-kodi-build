
<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="plugin.program.dekivas.installer"
         name="DekivaS Build Installer"
         version="1.0.0"
         provider-name="DekivaS">

    <requires>
      <import addon="xbmc.python" version="3.0.1"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
               library="default.py">
      <provides>executable</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
      <summary>DekivaS Build Installer</summary>
      <description>Instalacija DekivaS Kodi Build-a</description>
      <platform>all</platform>
    </extension>

  </addon>
</addons>
